pipeline {
    agent {
        docker {
            image 'node:20'
        }
    }
    parameters {
        choice(
            name: 'Env',
            choices: ['Test', 'Preprod', 'Prod'],
            description: 'Choisir l\'environnement'
        )
    }
    options {
        skipDefaultCheckout(true)
    }
    environment {
        POSTMAN_API_KEY = credentials('POSTMAN_API_KEY')
        COLLECTION_UID  = "52498919-4342299c-86b2-4afc-a5ea-bc45e4719ecb"
    }
    stages {
        stage('Clean Workspace') {
            steps {
                cleanWs()
            }
        }
        stage('Checkout GitHub') {
            steps {
                withCredentials([sshUserPrivateKey(
                    credentialsId: 'github-ssh-key',
                    keyFileVariable: 'SSH_KEY'
                )]) {
                    sh '''
                        apt-get update && apt-get install -y git openssh-client
                        mkdir -p ~/.ssh
                        cp $SSH_KEY ~/.ssh/id_rsa
                        chmod 600 ~/.ssh/id_rsa
                        ssh-keyscan github.com >> ~/.ssh/known_hosts
                        git clone git@github.com:SoniaSlimi/Projet-Jenkins.git .
                    '''
                }
            }
        }
        stage('Install Newman') {
            steps {
                sh 'npm install -g newman newman-reporter-html'
            }
        }
        stage('Run Postman Tests') {
            steps {
                sh """
                newman run "https://api.postman.com/collections/${COLLECTION_UID}?access_key=${POSTMAN_API_KEY}" \
                -e env_config/${params.Env}.json \
                -r cli,html \
                --reporter-html-export rapport.html
                """
            }
        }
    }
    post {
        always {
            archiveArtifacts artifacts: 'rapport.html', allowEmptyArchive: true
        }
        success {
            echo 'Tests OK'
        }
        failure {
            echo 'Tests FAILED'
        }
    }
}